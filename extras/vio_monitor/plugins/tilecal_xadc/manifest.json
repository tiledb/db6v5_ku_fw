{
  "id": "tilecal_xadc",
  "name": "TileCal DB xADC",
  "description": "TileCal analogue XADC conversion to voltages and monitor currents",
  "version": "1.0.0",
  "default_enabled": true,
  "order": 25,
  "requires_target": true,
  "requires_device": false,
  "requires_ltx": false,
  "tree_node_types": ["tilecal_xadc"],
  "probe_defaults": {
    "xadc_channel_voltage": "s_system_management_interface[xadc_channel_voltage]",
    "xadc_channel": "s_system_management_interface[xadc_channel]",
    "xadc_voltage_legacy": "probe_in98",
    "xadc_channel_legacy": "probe_in97"
  },
  "probe_labels": {
    "xadc_channel_voltage": "xadc_channel_voltage",
    "xadc_channel": "xadc_channel",
    "xadc_voltage_legacy": "probe_in98 (legacy)",
    "xadc_channel_legacy": "probe_in97 (legacy)"
  },
  "probe_hints": {
    "xadc_channel_voltage": "Live-scan raw voltage code",
    "xadc_channel": "Live-scan channel address",
    "xadc_voltage_legacy": "Fallback if probes use probe_in98",
    "xadc_channel_legacy": "Fallback if probes use probe_in97"
  },
  "assets": {
    "panel": "panel.html",
    "script": "plugin.js",
    "styles": ["styles.css"],
    "external_scripts": [
      "https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js",
      "https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"
    ]
  }
}
