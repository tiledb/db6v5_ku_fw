  "probe_hints": {
    "addr_probe_0": "s_sfp_reg_address_vio[0]",
    "addr_probe_1": "s_sfp_reg_address_vio[1]",
    "data_probe_0": "s_sfp_ku_mgt[sfp_tx_register][0]",
    "data_probe_1": "s_sfp_ku_mgt[sfp_tx_register][1]"
  },
  "assets": {
    "panel": "panel.html",
    "script": "plugin.js",
    "styles": ["styles.css"],
    "external_scripts": []
