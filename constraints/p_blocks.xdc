#add_cells_to_pblock [get_pblocks pblock_configbus] [get_cells -quiet [list i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_1 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_2 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_3 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_4 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_5 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_6 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_7 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_8 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_i_9 i_db6_gbtx_interface/i_db6_configbus_interface/s_bcrlock_local_reg {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local[0]_i_2} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[0]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[0]_i_1} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[10]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[11]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[12]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[13]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[14]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[15]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[16]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[16]_i_1} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[17]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[18]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[19]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[1]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[20]} {i_db6_gbtx_interface/i_db6_configbus_interface/s_counter_local_reg[21]} {i_db6_gb